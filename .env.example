# Azure AI Foundry API connection parameters
FOUNDRY_API_ENDPOINT=https://xxxxxxxxxx.services.ai.azure.com/api/projects/xxxxxxxxxxx
AGENT_SKILLS_GENERATOR_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_DOCUMENT_EVALUATOR_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_DOCUMENT_PARSER_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx

# Azure Content Understanding
CONTENT_UNDERSTANDING_ENDPOINT=https://xxxxxxxxxx.cognitiveservices.azure.com/
CONTENT_UNDERSTANDING_API_KEY=your-content-understanding-api-key-here
CONTENT_UNDERSTANDING_ANALYZER_ID=your-content-understanding-analyzer-id-here

# Azure Cosmos DB Configuration
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_DATABASE=pmo-agent-db
AZURE_COSMOS_KEY=your-cosmos-key-here

# Note: When using managed identity (recommended for production),
# you don't need to set AZURE_COSMOS_KEY as DefaultAzureCredential
# will handle authentication automatically.

# For local development with connection string (not recommended for production):
# AZURE_COSMOS_KEY=your-cosmos-key-here

# Other environment variables for your PMO Agent application
# Add your OpenAI API key, Azure AI Services keys, etc. here
