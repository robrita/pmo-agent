{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.5",
    "body": [
        {
            "type": "TextBlock",
            "text": "${body}",
            "wrap": true
        },
        {
            "type": "ActionSet",
            "actions": [
                {
                    "type": "Action.Submit",
                    "iconUrl": "icon:ThumbLike",
                    "title": "👍"
                },
                {
                    "type": "Action.Submit",
                    "iconUrl": "icon:ThumbDislike",
                    "title": "👎"
                }
            ]
        }
    ]
}